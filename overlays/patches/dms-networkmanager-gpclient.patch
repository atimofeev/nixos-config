+func TestSecretAgent_GetSecrets_GPClient(t *testing.T) {
+	conn := map[string]nmVariantMap{
+		"connection": {"id": dbus.MakeVariant("Work"), "uuid": dbus.MakeVariant("u-1"), "type": dbus.MakeVariant("vpn")},
+		"vpn": {
+			"service-type": dbus.MakeVariant("org.freedesktop.NetworkManager.gpclient"),
+			"data":         dbus.MakeVariant(map[string]string{"gateway": "vpn.example.test"}),
+		},
+	}
+	secrets := map[string]string{"cookie": `{"success":{"token":"secret"}}`, "gateway": "vpn.example.test"}
+	tests := []struct {
+		name, cachedUUID, connectingUUID string
+		flags                            uint32
+		wantSecrets                      bool
+	}{
+		{"cached", "u-1", "u-1", 0, true},
+		{"no interaction", "", "u-1", 0, false},
+		{"different UUID", "u-2", "u-1", 0, false},
+		{"only system", "u-1", "u-1", nmSecretAgentFlagOnlySystem, false},
+		{"different connection", "u-1", "u-2", nmSecretAgentFlagAllowInteraction, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			backend := &NetworkManagerBackend{state: &BackendState{IsConnectingVPN: true, ConnectingVPNUUID: tt.connectingUUID}}
+			if tt.cachedUUID != "" {
+				backend.cachedVPNSecrets = &cachedVPNSecrets{ConnectionUUID: tt.cachedUUID, Secrets: secrets}
+			}
+			agent := &SecretAgent{backend: backend}
+			out, err := agent.GetSecrets(conn, "/test/path", "vpn", nil, tt.flags)
+			if !tt.wantSecrets {
+				if assert.NotNil(t, err) {
+					assert.Contains(t, err.Name, "NoSecrets")
+				}
+				if tt.cachedUUID != "" {
+					assert.NotNil(t, backend.cachedVPNSecrets)
+				}
+				return
+			}
+			assert.Nil(t, err)
+			assert.Equal(t, secrets, out["vpn"]["secrets"].Value())
+			assert.Nil(t, backend.cachedVPNSecrets)
+			_, err = agent.GetSecrets(conn, "/test/path", "vpn", nil, 0)
+			if assert.NotNil(t, err) {
+				assert.Contains(t, err.Name, "NoSecrets")
+			}
 		})
 	}
