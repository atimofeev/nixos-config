+func runGPClientAuth(ctx context.Context, gateway string) (string, error) {
+	if gateway == "" {
+		return "", fmt.Errorf("gpclient gateway is empty")
+	}
+
+	gpauthPath, err := exec.LookPath("gpauth")
+	if err != nil {
+		return "", fmt.Errorf("gpauth not found: %w", err)
+	}
+
+	cmd := exec.CommandContext(ctx, gpauthPath, "--gateway", gateway)
+	output, err := cmd.Output()
+	if err != nil {
+		if ctx.Err() != nil {
+			return "", fmt.Errorf("gpauth timed out or was cancelled: %w", ctx.Err())
+		}
+		return "", fmt.Errorf("gpauth failed: %w", err)
+	}
+
+	authJSON := strings.TrimSpace(string(output))
+	if authJSON == "" {
+		return "", fmt.Errorf("gpauth produced no authentication JSON")
+	}
+
+	var result struct {
+		Success *json.RawMessage `json:"success"`
+		Failure *string          `json:"failure"`
+	}
+	if err := json.Unmarshal([]byte(authJSON), &result); err != nil {
+		return "", fmt.Errorf("gpauth produced unexpected authentication output")
+	}
+	if result.Success == nil {
+		if result.Failure != nil && *result.Failure != "" {
+			return "", fmt.Errorf("gpauth authentication cancelled: %s", *result.Failure)
+		}
+		return "", fmt.Errorf("gpauth authentication failed")
+	}
+	return authJSON, nil
+}
