+
+func TestGlobalHotkeysSchema(t *testing.T) {
+	cases := []struct {
+		name, record string
+		valid        bool
+	}{
+		{"global", `{shortCut: ";", global: command, description: Command mode, override: true}`, true},
+		{"resource", `{shortCut: p, command: pods}`, true},
+		{"empty-command", `{shortCut: ";", global: command, command: ""}`, true},
+		{"unknown", `{shortCut: q, global: unknown}`, false},
+		{"conflict", `{shortCut: q, global: back, command: pods}`, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			content := []byte("hotKeys:\n  test: " + tc.record + "\n")
+			err := data.JSONValidator.Validate(configjson.HotkeysSchema, content)
+			if tc.valid {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+	// Keep the upstream command-only fixture valid.
+	content, err := os.ReadFile("testdata/hotkeys/hotkeys.yaml")
+	require.NoError(t, err)
+	// Fixture intentionally uses its original vendor shortcut spelling.
+	require.NoError(t, data.JSONValidator.Validate(configjson.HotkeysSchema, content))
+}
+
+func TestGlobalHotkeysDecodeAndLoad(t *testing.T) {
+	content := []byte("hotKeys:\n  command: {shortCut: ';', global: command, description: Command mode, override: true}\n")
+	var decoded config.HotKeys
+	require.NoError(t, yaml.Unmarshal(content, &decoded))
+	require.Equal(t, "command", decoded.HotKey["command"].Global)
+	require.Empty(t, decoded.HotKey["command"].Command)
+	path := filepath.Join(t.TempDir(), "hotkeys.yaml")
+	require.NoError(t, os.WriteFile(path, content, 0600))
+	loaded := config.NewHotKeys()
+	require.NoError(t, loaded.LoadHotKeys(path))
+	require.Equal(t, decoded.HotKey, loaded.HotKey)
+}
