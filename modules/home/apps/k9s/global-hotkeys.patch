+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of K9s
+
+package view
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+
+	"github.com/derailed/k9s/internal/config"
+	"github.com/derailed/k9s/internal/ui"
+	"github.com/derailed/tcell/v2"
+)
+
+// Global shortcuts are aliases: dispatch still runs the original event handlers.
+var globalHotkeyTargets = map[string]tcell.Key{
+	"aliases":         tcell.KeyCtrlA,
+	"back":            tcell.KeyEscape,
+	"clear-filter":    tcell.KeyCtrlU,
+	"command":         ui.KeyColon,
+	"goto":            tcell.KeyEnter,
+	"help":            ui.KeyHelp,
+	"history-back":    ui.KeyLeftBracket,
+	"history-forward": ui.KeyRightBracket,
+	"last-view":       ui.KeyDash,
+	"persist":         tcell.KeyCtrlP,
+	"quit":            tcell.KeyCtrlC,
+	"redraw":          tcell.KeyCtrlR,
+	"toggle-crumbs":   tcell.KeyCtrlG,
+	"toggle-header":   tcell.KeyCtrlE,
+}
+
+type globalHotkey struct {
+	target   tcell.Key
+	override bool
+}
+
+func hotkeyCodes(shortcut string) ([]tcell.Key, error) {
+	key, err := asKey(shortcut)
+	if err != nil {
+		return nil, err
+	}
+	if key == tcell.KeyBackspace || key == tcell.KeyBackspace2 {
+		return []tcell.Key{tcell.KeyBackspace, tcell.KeyBackspace2}, nil
+	}
+	return []tcell.Key{key}, nil
+}
+
+func compileGlobalHotkeys(hh config.HotKeys) (map[tcell.Key]globalHotkey, error) {
+	names := make([]string, 0, len(hh.HotKey))
+	for name := range hh.HotKey {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	bindings := make(map[tcell.Key]globalHotkey)
+	owners := make(map[tcell.Key]string)
+	var errs error
+	for _, name := range names {
+		hk := hh.HotKey[name]
+		if hk.Global == "" {
+			continue
+		}
+		codes, err := hotkeyCodes(hk.ShortCut)
+		if err != nil {
+			errs = errors.Join(errs, fmt.Errorf("hotkey %q: %w", name, err))
+			continue
+		}
+		for _, code := range codes {
+			if owner, found := owners[code]; found {
+				errs = errors.Join(errs, fmt.Errorf("duplicate hotkey %q in %q and %q", hk.ShortCut, owner, name))
+			} else {
+				owners[code] = name
+			}
+		}
+		target, found := globalHotkeyTargets[hk.Global]
+		if !found {
+			errs = errors.Join(errs, fmt.Errorf("hotkey %q: unknown global action %q", name, hk.Global))
+			continue
+		}
+		if hk.Command != "" {
+			errs = errors.Join(errs, fmt.Errorf("hotkey %q: command and global are mutually exclusive", name))
+			continue
+		}
+		for _, code := range codes {
+			bindings[code] = globalHotkey{target: target, override: hk.Override}
+		}
+	}
+	// Reject ambiguous configurations atomically, leaving all default bindings intact.
+	if errs != nil {
+		return nil, errs
+	}
+	return bindings, nil
+}
+
+func (a *App) loadGlobalHotkeys() {
+	a.globalHotkeys = nil
+	hh := config.NewHotKeys()
+	if err := hh.Load(a.Config.ContextHotkeysPath()); err != nil {
+		a.Flash().Err(err)
+		return
+	}
+	bindings, err := compileGlobalHotkeys(hh)
+	if err != nil {
+		a.Flash().Err(err)
+		return
+	}
+	a.globalHotkeys = bindings
+}
+
+func (a *App) mapGlobalHotkey(evt *tcell.EventKey) *tcell.EventKey {
+	if a.Content.IsTopDialog() {
+		return evt
+	}
+	key := ui.AsKey(evt)
+	binding, found := a.globalHotkeys[key]
+	if !found {
+		return evt
+	}
+	if a.InCmdMode() {
+		// Text and editing keys must remain literal in every prompt.
+		switch evt.Key() {
+		case tcell.KeyRune, tcell.KeyBackspace, tcell.KeyBackspace2, tcell.KeyDelete:
+			return evt
+		}
+		if binding.target != tcell.KeyCtrlU && binding.target != tcell.KeyEnter {
+			return evt
+		}
+	}
+	if !binding.override {
+		if _, occupied := a.HasAction(key); occupied {
+			return evt
+		}
+		if view, ok := a.Content.Top().(interface{ Actions() *ui.KeyActions }); ok {
+			if _, occupied := view.Actions().Get(key); occupied {
+				return evt
+			}
+		}
+	}
+	if binding.target >= 32 && binding.target <= 126 {
+		return tcell.NewEventKey(tcell.KeyRune, rune(binding.target), tcell.ModNone)
+	}
+	return tcell.NewEventKey(binding.target, 0, tcell.ModNone)
+}
