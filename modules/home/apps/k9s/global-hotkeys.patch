+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of K9s
+
+package view
+
+import (
+	"testing"
+
+	"github.com/derailed/k9s/internal/config"
+	"github.com/derailed/k9s/internal/config/mock"
+	"github.com/derailed/k9s/internal/model"
+	"github.com/derailed/k9s/internal/ui"
+	"github.com/derailed/tcell/v2"
+	"github.com/derailed/tview"
+	"github.com/stretchr/testify/require"
+)
+
+func globalTestApp(t *testing.T) *App {
+	t.Helper()
+	a := &App{App: ui.NewApp(mock.NewMockConfig(t), ""), Content: NewPageStack()}
+	a.App.Init()
+	a.bindKeys()
+	var err error
+	a.globalHotkeys, err = compileGlobalHotkeys(config.HotKeys{HotKey: map[string]config.HotKey{
+		"command":   {ShortCut: ";", Global: "command", Override: true},
+		"backspace": {ShortCut: "Backspace", Global: "back", Override: true},
+		"back":      {ShortCut: "q", Global: "back", Override: true},
+	}})
+	require.NoError(t, err)
+	return a
+}
+
+func TestCompileGlobalHotkeys(t *testing.T) {
+	a := globalTestApp(t)
+	require.Len(t, a.globalHotkeys, 4)
+	for _, key := range []tcell.Key{tcell.KeyBackspace, tcell.KeyBackspace2, ui.KeyQ} {
+		require.Equal(t, tcell.KeyEscape, a.globalHotkeys[key].target)
+	}
+	require.Equal(t, tcell.Key(ui.KeyColon), a.globalHotkeys[tcell.Key(';')].target)
+	cases := map[string]map[string]config.HotKey{
+		"unknown":           {"a": {ShortCut: "q", Global: "unknown"}},
+		"conflict":          {"a": {ShortCut: "q", Global: "back", Command: "pods"}},
+		"invalid":           {"a": {ShortCut: "invalid", Global: "back"}},
+		"duplicate":         {"a": {ShortCut: "q", Global: "back"}, "b": {ShortCut: "q", Global: "command"}},
+		"backspace-overlap": {"a": {ShortCut: "Backspace", Global: "back"}, "b": {ShortCut: "Backspace2", Global: "back"}},
+	}
+	for name, hotkeys := range cases {
+		t.Run(name, func(t *testing.T) {
+			bindings, err := compileGlobalHotkeys(config.HotKeys{HotKey: hotkeys})
+			require.Error(t, err)
+			require.Nil(t, bindings)
+		})
+	}
+	bindings, err := compileGlobalHotkeys(config.HotKeys{HotKey: map[string]config.HotKey{
+		"global":             {ShortCut: "q", Global: "back"},
+		"invalid-resource":   {ShortCut: "invalid", Command: "pods"},
+		"resource":           {ShortCut: "q", Command: "pods"},
+		"duplicate-resource": {ShortCut: "q", Command: "nodes"},
+	}})
+	require.NoError(t, err)
+	require.Len(t, bindings, 1)
+}
+
+func TestGlobalHotkeyPunctuation(t *testing.T) {
+	for key := byte(32); key <= 126; key++ {
+		got, err := asKey(string(key))
+		require.NoError(t, err)
+		require.Equal(t, tcell.Key(key), got)
+	}
+	key, err := asKey("Ctrl-R")
+	// Named keys retain vendor spelling, rather than inventing punctuation syntax.
+	if err != nil {
+		key, err = asKey(tcell.KeyNames[tcell.KeyCtrlR])
+	}
+	require.NoError(t, err)
+	require.Equal(t, tcell.KeyCtrlR, key)
+}
+
+func TestGlobalHotkeysCommandAndDefault(t *testing.T) {
+	for _, r := range []rune{';', ':'} {
+		t.Run(string(r), func(t *testing.T) {
+			a := globalTestApp(t)
+			require.Nil(t, a.keyboard(tcell.NewEventKey(tcell.KeyRune, r, tcell.ModNone)))
+			require.True(t, a.InCmdMode())
+		})
+	}
+}
+
+func TestGlobalHotkeysNoConfigAndDialogs(t *testing.T) {
+	a := globalTestApp(t)
+	evt := tcell.NewEventKey(tcell.KeyRune, ';', tcell.ModNone)
+	a.globalHotkeys = nil
+	require.Same(t, evt, a.keyboard(evt))
+	require.False(t, a.InCmdMode())
+	a = globalTestApp(t)
+	a.Content.AddPage("dialog", tview.NewModalForm("Dialog", tview.NewForm()), true, true)
+	for _, evt := range []*tcell.EventKey{evt, tcell.NewEventKey(tcell.KeyRune, 'q', 0), tcell.NewEventKey(tcell.KeyBackspace, 0, 0)} {
+		require.Same(t, evt, a.keyboard(evt))
+	}
+	require.False(t, a.InCmdMode())
+}
+
+func TestGlobalHotkeysOverrideAndBackDispatch(t *testing.T) {
+	a := globalTestApp(t)
+	evt := tcell.NewEventKey(tcell.KeyCtrlE, 0, 0)
+	a.globalHotkeys[tcell.KeyCtrlE] = globalHotkey{target: tcell.KeyEscape}
+	require.Same(t, evt, a.mapGlobalHotkey(evt))
+	d := NewDetails(a, "test", "test", contentTXT, false)
+	invoked := 0
+	d.actions.Add(ui.KeyQ, ui.NewKeyAction("Local", func(*tcell.EventKey) *tcell.EventKey { invoked++; return nil }, false))
+	d.actions.Add(tcell.KeyEscape, ui.NewKeyAction("Back", func(*tcell.EventKey) *tcell.EventKey { invoked++; return nil }, false))
+	a.Content.Push(d)
+	q := tcell.NewEventKey(tcell.KeyRune, 'q', 0)
+	a.globalHotkeys[ui.KeyQ] = globalHotkey{target: tcell.KeyEscape}
+	require.Same(t, q, a.mapGlobalHotkey(q))
+	require.Nil(t, d.keyboard(a.keyboard(q)))
+	require.Equal(t, 1, invoked)
+	a.globalHotkeys[ui.KeyQ] = globalHotkey{target: tcell.KeyEscape, override: true}
+	for _, evt := range []*tcell.EventKey{q, tcell.NewEventKey(tcell.KeyBackspace, 0, 0), tcell.NewEventKey(tcell.KeyBackspace2, 0, 0)} {
+		mapped := a.keyboard(evt)
+		require.Equal(t, tcell.KeyEscape, mapped.Key())
+		require.Nil(t, d.keyboard(mapped))
+	}
+	require.Equal(t, 4, invoked)
+}
+
+func TestGlobalHotkeysPromptInput(t *testing.T) {
+	for _, filter := range []bool{false, true} {
+		t.Run(map[bool]string{false: "command", true: "filter"}[filter], func(t *testing.T) {
+			a := globalTestApp(t)
+			buff := a.CmdBuff()
+			if filter {
+				buff = model.NewFishBuff('/', model.FilterBuffer)
+			}
+			a.ResetPrompt(buff)
+			buff.SetActive(true)
+			require.True(t, a.InCmdMode())
+			for _, r := range []rune{'q', ';'} {
+				evt := tcell.NewEventKey(tcell.KeyRune, r, 0)
+				require.Same(t, evt, a.keyboard(evt))
+				a.Prompt().SendKey(a.keyboard(evt))
+			}
+			require.Equal(t, "q;", buff.GetText())
+			for _, key := range []tcell.Key{tcell.KeyBackspace, tcell.KeyBackspace2} {
+				evt := tcell.NewEventKey(key, 0, 0)
+				require.Same(t, evt, a.keyboard(evt))
+				a.Prompt().SendKey(a.keyboard(evt))
+			}
+			require.Empty(t, buff.GetText())
+		})
+	}
+}
+
+func TestGlobalHotkeysPromptControlActions(t *testing.T) {
+	for _, filter := range []bool{false, true} {
+		a := globalTestApp(t)
+		buff := a.CmdBuff()
+		if filter {
+			buff = model.NewFishBuff('/', model.FilterBuffer)
+		}
+		a.ResetPrompt(buff)
+		buff.SetText("query", "", true)
+		control := tcell.NewEventKey(tcell.KeyCtrlX, 0, 0)
+		for _, target := range []tcell.Key{tcell.KeyCtrlU, tcell.KeyEnter} {
+			a.globalHotkeys[tcell.KeyCtrlX] = globalHotkey{target: target, override: true}
+			mapped := a.mapGlobalHotkey(control)
+			require.Equal(t, target, mapped.Key())
+			if target == tcell.KeyCtrlU {
+				// Run the same global-to-prompt capture chain as live input.
+				if evt := a.keyboard(control); evt != nil {
+					a.Prompt().SendKey(evt)
+				}
+				require.Empty(t, buff.GetText())
+			}
+			for _, evt := range []*tcell.EventKey{
+				tcell.NewEventKey(tcell.KeyRune, 'q', 0),
+				tcell.NewEventKey(tcell.KeyRune, ';', 0),
+				tcell.NewEventKey(tcell.KeyBackspace, 0, 0),
+				tcell.NewEventKey(tcell.KeyBackspace2, 0, 0),
+				tcell.NewEventKey(tcell.KeyDelete, 0, 0),
+			} {
+				a.globalHotkeys[ui.AsKey(evt)] = globalHotkey{target: target, override: true}
+				require.Same(t, evt, a.mapGlobalHotkey(evt))
+			}
+		}
+		a.globalHotkeys[tcell.KeyCtrlX] = globalHotkey{target: tcell.KeyEscape, override: true}
+		require.Same(t, control, a.mapGlobalHotkey(control))
+	}
+}
