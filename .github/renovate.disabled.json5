{
  // Re-enable as renovate.json5 after this fix is released and grouped updates are verified:
  // https://github.com/renovatebot/renovate/pull/45258
  // It enables lock-only input updates without duplicating revision pins in flake.nix.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "dependencyDashboard": false,
  "enabledManagers": ["nix"],
  "lockFileMaintenance": {
    "enabled": false
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all other flake inputs; require manual merge.",
      "matchManagers": ["nix"],
      "groupName": "other"
    },
    {
      "description": "Only theme files and wallpapers may merge automatically.",
      "matchManagers": ["nix"],
      "matchDepNames": ["catppuccin-zen-browser", "github-avatar", "walls"],
      "groupName": "assets",
      "automerge": true,
      "platformAutomerge": false,
      "statusCheckWhen": {
        "artifactError": "always"
      }
    },
    {
      "description": "Never update package sets or Home Manager automatically.",
      "matchManagers": ["nix"],
      "matchDepNames": ["home-manager", "nixpkgs", "nixpkgs-unstable"],
      "groupName": "system",
      "enabled": false
    }
  ],
  "timezone": "Europe/Podgorica"
}
